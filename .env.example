# === REQUIRED ===
OPENAI_API_KEY=sk-proj-...

# === RECOMMENDED ===
TAVILY_API_KEY=tvly-...

# === LangSmith Tracing (highly recommended) ===
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=stock-agent-v2.5

# === Production / FastAPI ===
SECRET_KEY=super-secret-key-change-in-prod
CORS_ORIGINS=["http://localhost:3000", "https://your-app.azurewebsites.net"]
ENVIRONMENT=development
LOG_LEVEL=INFO

# === Self-Improvement ===
PERFORMANCE_LOG_PATH=logs/performance.jsonl
MIN_ACCURACY_THRESHOLD=0.52

# === Code Writing Agent Error Emails ===
ERROR_EMAIL=hullc2003@gmail.com
# SMTP settings (optional - for real email alerts)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password